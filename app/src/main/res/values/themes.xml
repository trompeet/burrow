<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors kiwix-android's KiwixTheme: Theme.MaterialComponents (not Material 3), black app bars. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.KiwixReader" parent="Base.KiwixReader">
        <item name="android:isLightTheme" tools:targetApi="q">true</item>
        <item name="colorPrimary">@color/denim_blue800</item>
        <item name="colorSurface">@color/alabaster_white</item>
        <item name="colorError">@color/monza_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnError">@color/alabaster_white</item>
        <item name="statusOnline">@color/startServerGreen</item>
        <item name="statusOffline">@color/stopServerRed</item>
    </style>

    <style name="Base.KiwixReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimaryVariant">?colorPrimary</item>
        <item name="colorSecondary">?colorPrimary</item>
        <item name="colorSecondaryVariant">?colorPrimary</item>
        <item name="colorOnSecondary">?colorOnPrimary</item>
        <item name="colorOnBackground">?colorOnSurface</item>
        <item name="android:colorBackground">?colorSurface</item>
        <item name="colorPrimaryDark">?colorPrimaryVariant</item>
        <item name="colorAccent">?colorSecondary</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="toolbarStyle">@style/Widget.KiwixReader.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.KiwixReader.BottomNavigationView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.Dialog.Alert</item>
    </style>
</resources>
