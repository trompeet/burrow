<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KiwixReader" parent="Base.KiwixReader">
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/denim_blue200</item>
        <item name="colorSurface">@color/mine_shaft_gray900</item>
        <item name="colorError">@color/froly_pink300</item>
        <item name="colorOnPrimary">@color/alabaster_white</item>
        <item name="colorOnSurface">@color/alabaster_white</item>
        <item name="colorOnError">@color/alabaster_white</item>
        <!-- Keep the "Kiwix blue" filled buttons in dark mode, as kiwix-android does. -->
        <item name="materialButtonStyle">@style/Widget.KiwixReader.Button</item>
        <item name="statusOnline">#81c784</item>
        <item name="statusOffline">@color/froly_pink300</item>
    </style>
</resources>
