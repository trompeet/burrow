<?xml version="1.0" encoding="utf-8"?>
<!-- kiwix-serve usually runs on a LAN over plain HTTP (e.g. http://192.168.1.10:8080), so cleartext is allowed.
     Traffic only ever goes to servers the user adds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
